{
  "opencollection": "1.0.0",
  "info": {
    "name": "Radar Events Track API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Track",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Track a user location",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.radar.io/v1/track"
          },
          "docs": "Track a user location"
        }
      ]
    }
  ],
  "bundled": true
}