{
  "opencollection": "1.0.0",
  "info": {
    "name": "Radar Events API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.radar.io/v1/events"
          },
          "docs": "List events"
        },
        {
          "info": {
            "name": "Retrieve an event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.radar.io/v1/events/:eventId",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve an event"
        }
      ]
    }
  ],
  "bundled": true
}